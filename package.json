{
  "name": "cibc-ya-later",
  "version": "0.1.0",
  "description": "Private CIBC downloads and SimpleFIN for macOS",
  "main": "out/main/index.js",
  "author": "Louis Mollick",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "package": "pnpm run build && electron-builder --mac dir",
    "dist": "pnpm run build && electron-builder --mac dmg",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/ms-playwright playwright install chromium",
    "icons": "swift scripts/make-icons.swift",
    "smoke": "node scripts/smoke.mjs",
    "shortcut:export": "tsx scripts/export-shortcut.ts"
  },
  "build": {
    "appId": "ca.louismollick.cibc-ya-later",
    "productName": "CIBC Ya Later",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/trayTemplate.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/playwright*/**/*",
      "node_modules/@napi-rs/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.png"
    },
    "extraResources": [
      {
        "from": "node_modules/.cache/ms-playwright",
        "to": "browsers",
        "filter": [
          "chromium-*/**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "playwright": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.21.0"
}
